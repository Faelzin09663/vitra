# Server-only: filled values belong in Supabase Edge Functions Secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional overrides fall back to GEMINI_MODEL.
GEMINI_MODEL_MEAL=
GEMINI_MODEL_BODY=
GEMINI_MODEL_COACH=
# Trusted administrative REST base URL only; never supplied by users.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
ALLOWED_ORIGINS=http://localhost:5173