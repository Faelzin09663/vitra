VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA-CHAVE-PUBLICA

# Todas as credenciais ficam neste arquivo. Somente VITE_* entra no navegador.
# Backend: copie a Secret key em Supabase > Settings > API Keys.
# Nunca adicione VITE_ ao nome das chaves abaixo.
SUPABASE_SECRET_KEY=
# Alternativa legada aceita: SUPABASE_SERVICE_ROLE_KEY (sem VITE_).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_MEAL=
GEMINI_MODEL_BODY=
GEMINI_MODEL_COACH=
GEMINI_MODEL_VIT=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787,http://localhost:4173
API_PORT=8787
# Deixe /api para frontend e backend no mesmo domínio.
VITE_API_URL=/api
